{
  "name": "@bmp/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "migrate-tender-folders": "tsx scripts/migrate-tender-folders.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf generated dist .turbo",
    "migrate:create": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@bmp/types": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@bmp/config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
